# Envio do formulário de orçamento (SMTP da Hostinger).
# Copie para .env.local no seu computador. Na Hostinger, cadastre estas
# variáveis nas configurações do app Node.js. Nunca faça commit da senha.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@covalia.com.br
SMTP_PASS=
# Para onde os pedidos vão. Se vazio, usa o próprio SMTP_USER.
MAIL_TO=contato@covalia.com.br
